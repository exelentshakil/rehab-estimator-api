# ---------------------------------------------------------------------------
# Photo Condition & Rehab Estimator — environment
#
# The app runs with ZERO of these set: it falls back to a deterministic
# simulator for vision, in-memory job storage, and inline (non-queued)
# execution. That is enough to review the pricing engine end to end.
# Add keys to turn each layer on.
# ---------------------------------------------------------------------------

# --- Vision provider (pick one; gemini is the default when both are present)
VISION_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Comma-separated fallback chain. The first model that answers wins, so a
# single deprecation cannot take the endpoint down.
GEMINI_MODEL=gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash
OPENAI_MODEL=gpt-5,gpt-4.1-mini,gpt-4o-mini

# --- Job persistence (required on Vercel: serverless has no shared memory)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Async queue. Unset => jobs run inline in the request.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
